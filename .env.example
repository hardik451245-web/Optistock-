# OptiStock AI - Environment Configuration Template
# Copy this file to .env and configure your local or production credentials

# Server Port
SERVER_PORT=8080

# Active Profile: 'demo' (in-memory H2) or 'default' (MySQL)
SPRING_PROFILES_ACTIVE=demo

# Database Credentials (MySQL)
DB_URL=jdbc:mysql://localhost:3306/optistock?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Manager Registration Authorization Code
OPTISTOCK_MANAGER_CODE=OPTISTOCK-MGR-2026

# Allowed Frontend Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Business Rules
OPTISTOCK_MIN_MARGIN_PERCENT=10

# Frontend API URL (Vite client deployment)
# Set to your deployed backend URL (leave empty if using same-domain reverse proxy)
VITE_API_BASE_URL=https://your-backend-api-url.onrender.com
