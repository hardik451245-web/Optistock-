								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					}
				},
				{
					"name": "Create Product (Manager)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managerToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Green Tea Premium\",\n  \"brand\": \"Organic India\",\n  \"category\": \"Beverages\",\n  \"costPrice\": 120.00,\n  \"sellingPrice\": 180.00,\n  \"stockQuantity\": 50,\n  \"reorderThreshold\": 15,\n  \"expiryDate\": \"2026-12-31\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					}
				},
				{
					"name": "Update Product (Manager)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managerToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Green Tea Premium - 100g\",\n  \"brand\": \"Organic India\",\n  \"category\": \"Beverages\",\n  \"costPrice\": 120.00,\n  \"sellingPrice\": 175.00,\n  \"stockQuantity\": 45,\n  \"reorderThreshold\": 15,\n  \"expiryDate\": \"2026-12-31\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"1"
							]
						}
					}
				},
				{
					"name": "Delete Product (Manager)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{managerToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/products/1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"products",
								"1"
							]
						}
					}
				}
			]
		},
