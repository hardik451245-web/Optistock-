{
	"info": {
		"_postman_id": "optistock-ai-collection-v1",
		"name": "OptiStock AI API Collection",
		"description": "Comprehensive Postman collection for the OptiStock AI inventory and billing platform, including automated token persistence scripts and role-based request templates.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "managerToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "cashierToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login - Manager",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var data = pm.response.json();",
									"if (data.token) {",
									"    pm.collectionVariables.set('token', data.token);",
									"    pm.collectionVariables.set('managerToken', data.token);",
									"    pm.test('Token saved to collection variables', function () {",
									"        pm.expect(data.token).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"manager@optistock.com\",\n  \"password\": \"manager123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"login"
							]
						}
					}
				},
				{
					"name": "Login - Cashier",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var data = pm.response.json();",
									"if (data.token) {",
									"    pm.collectionVariables.set('token', data.token);",
									"    pm.collectionVariables.set('cashierToken', data.token);",
									"    pm.test('Cashier token saved', function () {",
									"        pm.expect(data.token).to.be.a('string');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"cashier@optistock.com\",\n  \"password\": \"cashier123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"login"
							]
						}
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get Products (with Expiry Quotes)",
					"request": {
						"method": "GET",
