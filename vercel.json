{
  "framework": "vite",
  "buildCommand": "cd OptiStock/optistock-frontend && npm install && npm run build",
  "outputDirectory": "OptiStock/optistock-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
